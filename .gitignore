# SQL Practice Repository - .gitignore

# =====================
# Database Files
# =====================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.ldb
*.myd
*.myi
*.frm
*.ibd
*.ib_logfile*
*.sdf
*.accdb
*.mdb

# =====================
# Database Backups & Dumps
# =====================
*.bak
*.backup
*.dump
*.sql.gz
*.sql.bz2
backups/
dump/

# =====================
# OS Files
# =====================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp

# =====================
# IDE / Editor Files
# =====================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.sublime-settings
.project
.classpath
.settings/
*.code-workspace

# =====================
# Logs
# =====================
*.log
logs/

# =====================
# Environment / Configs
# =====================
.env
.env.local
.env.*.local
*.env

# =====================
# Python Virtual Environment (if using Python scripts)
# =====================
venv/
.venv/
env/
__pycache__/
*.pyc

# =====================
# Node (if using JavaScript tools)
# =====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =====================
# Docker (optional)
# =====================
docker-compose.override.yml

# =====================
# Compiled files
# =====================
*.jar
*.war
*.class

# =====================
# Git
# =====================
*.orig
*.rej

